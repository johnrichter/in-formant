FROM --platform=linux/amd64 ubuntu:20.04 AS build

ENV DEBIAN_FRONTEND noninteractive

RUN apt-get update -y && \
        apt-get install -y \
            build-essential \
            clang-11 \
            clang++-11 \
            llvm-11-dev \
            llvm-11-tools \
            libxml2-dev \
            uuid-dev \
            libssl-dev \
            make \
            tar \
            xz-utils \
            bzip2 \
            gzip \
            cpio \
            libbz2-dev \    
            zlib1g-dev \
            cmake \
            git \
            python3 python3-pip python-is-python3

RUN ln -s /usr/bin/clang-11 /usr/bin/clang && \
        ln -s /usr/bin/clang++-11 /usr/bin/clang++ && \
        ln -s /usr/bin/llvm-config-11 /usr/bin/llvm-config

# osxcross resolves symlinks, so clang++ would run as plain clang and skip -lc++. A hard link keeps the clang++ name.
RUN ln -f /usr/lib/llvm-11/bin/clang /usr/lib/llvm-11/bin/clang++

COPY MacOSX11.3.sdk.tar.xz /dockerbuild/MacOSX11.3.sdk.tar.xz
RUN git clone https://github.com/tpoechtrager/osxcross && \
        mv /dockerbuild/MacOSX11.3.sdk.tar.xz osxcross/tarballs && \
        cd osxcross && \
        UNATTENDED=1 ./build.sh

# Build for Apple silicon by default. Use --build-arg TARGET_ARCH=x86_64 for an Intel build.
# Qt 6.2 is the first release with universal (x86_64 and arm64) macOS binaries.
ARG TARGET_ARCH=arm64
ENV TARGET_ARCH=$TARGET_ARCH
ENV HOST=$TARGET_ARCH-apple-darwin20.4
ENV QT_VERSION=6.2.4

# Install qt
RUN pip install aqtinstall==1.2.2
COPY aqtinstall-patch/updater.py /usr/local/lib/python3.8/dist-packages/aqt
RUN aqt install $QT_VERSION mac desktop -m addons.qtcharts --outputdir /opt/Qt

# Replace mac binaries with linux Binaries
RUN aqt install $QT_VERSION linux desktop --noarchives -m qtbase qtdeclarative icu --outputdir /opt/Qt && \
	rm -r /opt/Qt/$QT_VERSION/macos/bin /opt/Qt/$QT_VERSION/macos/libexec && \
	ln -s /opt/Qt/$QT_VERSION/gcc_64/bin /opt/Qt/$QT_VERSION/macos/bin && \
	ln -s /opt/Qt/$QT_VERSION/gcc_64/libexec /opt/Qt/$QT_VERSION/macos/libexec

# Qt 6.2 moved qmlimportscanner to libexec, but macdeployqt looks for it in bin.
RUN ln -s /opt/Qt/$QT_VERSION/gcc_64/libexec/qmlimportscanner /opt/Qt/$QT_VERSION/gcc_64/bin/qmlimportscanner

# The macOS binaries from Qt 6.2 are universal (x86_64 and arm64). macdeployqt cannot parse the otool output
# of a universal file, so reduce every Qt binary to the target architecture. This also halves the bundle size.
RUN cd /opt/Qt/$QT_VERSION/macos && \
	find lib plugins qml -type f | while read f; do \
	    if /osxcross/target/bin/$HOST-lipo -info "$f" 2>/dev/null | grep -q "Architectures in the fat file"; then \
	        /osxcross/target/bin/$HOST-lipo -thin $TARGET_ARCH "$f" -output "$f.thin" && mv "$f.thin" "$f" && chmod 755 "$f"; \
	    fi; \
	done

ENV PATH /osxcross/target/bin:$PATH
ENV CC /osxcross/target/bin/$HOST-clang
ENV CXX /osxcross/target/bin/$HOST-clang++

RUN apt-get update -y && apt-get install -y autoconf wget

WORKDIR /dockerbuild

# Build portaudio
RUN wget http://files.portaudio.com/archives/pa_stable_v190700_20210406.tgz && \
        tar -xvf pa_stable_v190700_20210406.tgz
RUN cd portaudio && \
        autoconf && \
        mkdir objs && \
        cd objs && \
        CFLAGS="-arch $TARGET_ARCH -Wno-implicit-int-float-conversion" \
        ../configure --host=$(echo $HOST | sed 's/^arm64/aarch64/') --prefix=/osxcross/target/$HOST --enable-shared --disable-static --disable-mac-universal --disable-dependency-tracking && \
        make -j$(nproc) && \
        make install

# Build fftw3
ENV ver=3.3.9
RUN wget http://www.fftw.org/fftw-$ver.tar.gz && \
        tar -xvf fftw-$ver.tar.gz
RUN cd fftw-$ver && \
        mkdir build && \
        cd build && \
        CFLAGS="-arch $TARGET_ARCH" \
        ../configure --host=$(echo $HOST | sed 's/^arm64/aarch64/') --prefix=/osxcross/target/$HOST --enable-shared --disable-static --disable-mac-universal --disable-dependency-tracking && \
        make -j$(nproc) && \
        make install

# Build eigen3
ENV ver=3.3.9
RUN wget https://gitlab.com/libeigen/eigen/-/archive/$ver/eigen-$ver.tar.gz && \
        tar -xvf eigen-$ver.tar.gz
RUN cd eigen-$ver && \
        mkdir build && \
        cd build && \
        $HOST-cmake -DCMAKE_INSTALL_PREFIX=/osxcross/target/$HOST .. && \
        make -j$(nproc) && \
        make install 

RUN apt-get update -y && apt-get install -y pkg-config qt5-qmake qtbase5-dev unzip zlib1g-dev hfsprogs
RUN wget https://github.com/clo-yunhee/pytorch_osx_cross/releases/download/1.7.1-osx-cross-1/libtorch-x86_64-darwin18.tar.gz && \
        tar -xvf libtorch-x86_64-darwin18.tar.gz -C /usr

RUN git clone https://github.com/planetbeing/libdmg-hfsplus -b openssl-1.1
RUN cd libdmg-hfsplus && \
        mkdir build && \
        cd build && \
        CC= CXX= cmake .. -DCMAKE_INSTALL_PREFIX=/usr && \
        make -j$(nproc) && \
        make install

# Apple silicon refuses to run an arm64 file with an invalid signature, and install_name_tool breaks the signature.
# rcodesign signs the bundle again (ad hoc) after macdeployqt. The archive checksum comes from the release page.
RUN wget -q https://github.com/indygreg/apple-platform-rs/releases/download/apple-codesign/0.29.0/apple-codesign-0.29.0-x86_64-unknown-linux-musl.tar.gz && \
        echo "dbe85cedd8ee4217b64e9a0e4c2aef92ab8bcaaa41f20bde99781ff02e600002  apple-codesign-0.29.0-x86_64-unknown-linux-musl.tar.gz" | sha256sum -c - && \
        tar -xzf apple-codesign-0.29.0-x86_64-unknown-linux-musl.tar.gz --strip-components=1 -C /usr/local/bin apple-codesign-0.29.0-x86_64-unknown-linux-musl/rcodesign

COPY macdeployqt macdeployqt
RUN cd macdeployqt && \
        /opt/Qt/$QT_VERSION/macos/bin/qmake && \
        make -j$(nproc) && \
        cp macdeployqt /osxcross/target/bin

RUN rm -r /dockerbuild

COPY macos-toolchain.cmake /usr/macos-toolchain.cmake

RUN apt-get update -y && apt-get install -y ccache
ENV CCACHE_DIR=/ccache

RUN groupadd -g 1000 swu && useradd -m -u 1000 -g swu swu

# The build runs as root: deploy-macos.sh and macdeployqt write /InFormant.app and /InFormant.dmg at the container root.
# Docker does not keep a chown of /, so the swu user cannot get write access there.
#USER swu

CMD cd /build && \
        export version=`cat /src/version` && \
        export QT_DIR=/opt/Qt/$QT_VERSION/macos && \
        if [ "$TARGET_ARCH" = arm64 ]; then export MACOSX_DEPLOYMENT_TARGET=11.0; else export MACOSX_DEPLOYMENT_TARGET=10.14; fi && \
        $HOST-cmake \
            -DCUR_VERSION=$version \
            -DCMAKE_TOOLCHAIN_FILE=/usr/macos-toolchain.cmake \
            -DCMAKE_BUILD_TYPE=$CMAKE_BUILD_TYPE \
            -DCMAKE_PREFIX_PATH="/opt/Qt/$QT_VERSION/macos;/osxcross/target/$HOST;/usr/libtorch" \
            -DENABLE_TORCH=$ENABLE_TORCH \
            /src && \
        make -j$(nproc) && \
        DIST_SUFFIX=macos-$TARGET_ARCH \
        /src/docker/deploy-macos.sh

